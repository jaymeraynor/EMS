# Copy to .env and replace every placeholder. Never commit .env.
POSTGRES_USER=ems
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ems
# >= 32 random characters, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
EMS_ENV=production
# Comma separated browser origins allowed for cross-origin API calls. Leave empty: nginx serves same-origin.
CORS_ORIGINS=
# Published on 127.0.0.1 only; put a TLS reverse proxy in front for remote access.
WEB_PORT=8080
